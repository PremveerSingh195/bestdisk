{
  "name": "bestdisk",
  "version": "1.0.0",
  "description": "Bestdisk — a macOS disk space analyzer and manager",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "Premveer Singh",
    "email": "your@email.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PremveerSingh195/bestdisk"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "probe": "electron scripts/probe-renderer.cjs",
    "smoke": "npm run smoke:build && node out/main/smoke.cjs",
    "smoke:build": "electron-vite build && esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --target=node20 --outfile=out/main/smoke.cjs --alias:@shared=./src/shared --log-level=warning",
    "build": "npm run typecheck && electron-vite build",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:universal": "npm run build && electron-builder --mac --universal",
    "build:unpack": "npm run build && electron-builder --dir",
    "release": "npm run build && electron-builder --publish=onTagOrDraft"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.400.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.11",
    "recharts": "^2.15.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "zustand": "^4.5.7"
  }
}